{
    "name": "marciomdrs/filament-cep-field",
    "description": "A Filament CEP (Brazilian zip code) field that auto-fills address, neighborhood, city and state.",
    "type": "library",
    "license": "MIT",
    "keywords": ["filament", "cep", "laravel", "address", "viacep", "brasilapi"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Marciomdrs\\FilamentCepField\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
